#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
export LC_ALL=C

die() { printf 'wp-migrate: %s\n' "$*" >&2; exit 1; }
log() { printf '%s\n' "$*" >&2; }
usage() {
  cat <<'EOF'
wp-migrate                         # interactive wizard
wp-migrate {preflight|dry-run|apply|rollback} --wp CONTAINER --db CONTAINER
  --database NAME --db-cnf /path/in/db/container.cnf --prefix wp_
  [--mount /var/www/html] [--content /var/www/html/wp-content]
  [--state /var/lib/wp-migrate-kit] [--uid 33 --gid 33]
  [--updraft DIR --set BACKUP_STEM | --files ARCHIVE --sql DUMP]
  [--s3 s3://BUCKET/PREFIX/ [--endpoint https://HOST] [--region REGION]
   [--profile PROFILE | --s3-prompt]]
  [--max-gib 50] [--yes]
EOF
}

run_cli() (
set -e
exec </dev/null
action=$1
shift
case "$action" in
  -h|--help) usage; exit 0 ;;
  preflight|dry-run|apply|rollback) ;;
  *) die 'Unknown command' ;;
esac
wp= db= database= db_cnf= prefix= updraft= set= files= sql= s3= endpoint= profile= region=
mount=/var/www/html content=/var/www/html/wp-content state=/var/lib/wp-migrate-kit
uid=33 gid=33 max_gib=50 yes=false s3_prompt=false
while (($#)); do
  case "$1" in
    --yes) yes=true; shift; continue ;;
    --s3-prompt) s3_prompt=true; shift; continue ;;
    --wp|--db|--database|--db-cnf|--prefix|--mount|--content|--state|--uid|--gid|--updraft|--set|--files|--sql|--s3|--endpoint|--profile|--region|--max-gib)
      (($# >= 2)) && [[ -n $2 && $2 != --* ]] || die "Missing value for $1"
      option=$1
      option=${option#--}
      printf -v "${option//-/_}" '%s' "$2"
      shift 2 ;;
    *) die "Unknown option: $1" ;;
  esac
done

[[ $(uname -s) == Linux && $EUID == 0 ]] || die 'Run as root on the Linux Docker host'
[[ $wp =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && $db =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && $wp != "$db" ]] || die 'Specify distinct WordPress and DB containers'
[[ $database =~ ^[a-zA-Z0-9_]{1,64}$ && $prefix =~ ^[a-zA-Z0-9_]{1,40}$ ]] || die 'Invalid database name or table prefix'
case "${database,,}" in mysql|sys|performance_schema|information_schema) die 'System database forbidden';; esac
[[ $db_cnf =~ ^/[a-zA-Z0-9_./-]+$ && $state == /* ]] || die 'Specify absolute DB option file and state paths'
[[ $uid =~ ^[0-9]{1,9}$ && $gid =~ ^[0-9]{1,9}$ && $max_gib =~ ^[1-9][0-9]{0,2}$ ]] || die 'Invalid UID, GID or size limit'
if [[ $action == apply || $action == rollback ]]; then
  $yes || die 'Review dry-run and pass --yes for a write operation'
fi
if [[ $action != rollback ]]; then
  if [[ -n $set ]]; then
    [[ -z $files && -z $sql && ( -n $updraft || -n $s3 ) ]] || die 'Choose one backup format'
  else
    [[ -z $updraft && -n $files && -n $sql ]] || die 'Specify --set or both --files and --sql'
  fi
  if [[ -n $s3 ]]; then
    [[ -z $updraft && $s3 =~ ^s3://[a-zA-Z0-9.-]+/[^[:space:]]+/$ ]] || die 'Use a dedicated S3 prefix with a trailing slash'
    [[ -z $endpoint || $endpoint =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?$ ]] || die 'Invalid HTTPS S3 endpoint'
    [[ -z $region || $region =~ ^[a-zA-Z0-9-]+$ ]] || die 'Invalid S3 region'
    if $s3_prompt; then [[ -z $profile ]] || die 'Choose --s3-prompt or --profile'; fi
    command -v aws >/dev/null || die 'AWS CLI is required'
  else
    [[ -z $endpoint && -z $profile && -z $region ]] && ! $s3_prompt || die 'S3 options require --s3'
  fi
fi
for dep in docker python3 rsync flock realpath sha256sum sync stat install df; do
  command -v "$dep" >/dev/null || die "Missing dependency: $dep"
done
unset DOCKER_HOST DOCKER_CONTEXT
export DOCKER_HOST=unix:///var/run/docker.sock
# BEGIN ARCHIVE HELPER
backup_helper() {
  local script_dir
  script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
  python3 "$script_dir/lib/backup.py" "$@"
}
# END ARCHIVE HELPER
temp=
snapshot=
armed=false
db_id=
target=
query() {
  docker exec -i "$db_id" "$client" "--defaults-file=$db_cnf" --protocol=socket --binary-mode --local-infile=0 --batch --skip-column-names "$@"
}
restore_snapshot() {
  backup_helper verify "$snapshot" || return 1
  [[ $(resolve_target stopped) == "$target" ]] || return 1
  query < "$snapshot/db.sql" || return 1
  rsync -aHAX --numeric-ids --delete -- "$snapshot/content/" "$target/" || return 1
  sync -f "$target" || return 1
  mark rolled-back || return 1
}
cleanup() {
  local status=$?
  trap - EXIT
  trap '' INT TERM
  if ((status)) && $armed; then
    log "Apply failed. Restoring snapshot $snapshot"
    if restore_snapshot; then
      log 'Automatic rollback completed. WordPress remains stopped.'
    else
      log 'Automatic rollback failed. Keep WordPress stopped and retry rollback.'
    fi
  fi
  if [[ -n $temp ]]; then rm -rf -- "$temp"; fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

resolve_target() {
  backup_helper target "$wp" "$mount" "$content" "$1"
}
mode=any
if [[ $action == apply || $action == rollback ]]; then mode=stopped; fi
target=$(resolve_target "$mode")
db_id=$(docker inspect --type container --format '{{if .State.Running}}{{.Id}}{{end}}' "$db")
[[ -n $db_id ]] || die 'DB container must be running'
state=$(realpath -m -- "$state")
[[ $state != / && "$state/" != "$target/"* && "$target/" != "$state/"* ]] || die 'State and WordPress content must be separate'
backup_helper state-path "$state"
client=$(docker exec "$db_id" sh -ec 'command -v mariadb || command -v mysql')
dump=$(docker exec "$db_id" sh -ec 'command -v mariadb-dump || command -v mysqldump')
[[ $(query "$database" -e 'SELECT DATABASE()') == "$database" ]] || die 'Database connection failed'
log "WordPress content: $target"
log "Database: $database in $db"
df -h -- "$target"
if [[ $action == preflight ]]; then
  log 'Target and DB connection checked. Run dry-run to validate and stage the backup.'
  exit 0
fi

mark() {
  printf '%s\n' "$1" > "$snapshot/.status.tmp" &&
    mv -f -- "$snapshot/.status.tmp" "$snapshot/status" &&
    sync -f "$snapshot"
}
if [[ $action == apply || $action == rollback ]]; then
  exec 8<"$target"
  flock -n 8 || die 'Another migration is using this wp-content directory'
  install -d -m 0700 -- "$state"
  [[ $(stat -c '%u:%a' -- "$state") == 0:700 ]] || die 'State directory must be root-owned with mode 0700'
  exec 9>"$state/lock"
  flock -n 9 || die 'Another migration is using this state directory'
  [[ $(resolve_target stopped) == "$target" ]] || die 'WordPress mount changed'
  key=$(printf '%s\0' "$target" "$db_id" "$database" | sha256sum)
  key=${key%% *}
  slot=$state/$key
  mkdir -p -- "$slot"
  if [[ -e $slot/latest ]]; then
    mapfile -t -n 1 snapshot_state < "$slot/latest"
    latest=${snapshot_state[0]-}
    [[ $latest =~ ^snap\.[a-zA-Z0-9]+$ ]] ||
      die "Invalid snapshot pointer in $slot/latest: $(printf '%q' "$latest")"
    snapshot=$slot/$latest
    mapfile -t -n 1 snapshot_state < "$snapshot/status"
    status=${snapshot_state[0]-}
    case "$status" in pending|applied|rolled-back) ;; *) die 'Invalid snapshot status';; esac
  else
    status=none
  fi
  if [[ $action == rollback ]]; then
    [[ $status != none ]] || die 'No snapshot for this target'
    [[ $status != rolled-back ]] || { log 'Already rolled back'; exit 0; }
    restore_snapshot || die 'Rollback incomplete. Keep WordPress stopped and retry.'
    log "Rollback completed: $snapshot"
    exit 0
  fi
  [[ $status != pending ]] || die 'Interrupted apply. Run rollback first.'
  temp=$(mktemp -d -- "$slot/stage.XXXXXXXX")
else
  temp=$(mktemp -d)
fi

download_backup() (
  set +x
  mkdir -- "$temp/download"
  if $s3_prompt; then
    if ! { exec 7<>/dev/tty; } 2>/dev/null; then
      die '--s3-prompt requires an interactive terminal'
    fi
    unset AWS_PROFILE AWS_DEFAULT_PROFILE AWS_SESSION_TOKEN AWS_SECURITY_TOKEN
    IFS= read -rs -p 'S3 access key ID: ' AWS_ACCESS_KEY_ID <&7 || die 'No access key entered'
    printf '\n' >&7
    IFS= read -rs -p 'S3 secret access key: ' AWS_SECRET_ACCESS_KEY <&7 || die 'No secret key entered'
    printf '\n' >&7
    IFS= read -rs -p 'S3 session token (Enter to skip): ' AWS_SESSION_TOKEN <&7 || die 'Input cancelled'
    printf '\n' >&7
    exec 7>&-
    [[ -n $AWS_ACCESS_KEY_ID && -n $AWS_SECRET_ACCESS_KEY ]] || die 'Both S3 keys are required'
    export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
    if [[ -n $AWS_SESSION_TOKEN ]]; then export AWS_SESSION_TOKEN; else unset AWS_SESSION_TOKEN; fi
  fi
  aws_args=()
  [[ -z $endpoint ]] || aws_args+=(--endpoint-url "$endpoint")
  [[ -z $profile ]] || aws_args+=(--profile "$profile")
  if [[ -z $region && $endpoint == https://*.r2.cloudflarestorage.com ]]; then region=auto; fi
  [[ -z $region ]] || aws_args+=(--region "$region")
  log 'Downloading backup from S3...'
  if [[ -n $set ]]; then
    [[ $set =~ ^backup_[a-zA-Z0-9_.-]+$ ]] || die 'Invalid UpdraftPlus backup stem'
    aws "${aws_args[@]}" s3 cp "$s3" "$temp/download" --recursive \
      --no-follow-symlinks --exclude '*' --include "$set-*" --only-show-errors
  else
    [[ $files =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && $sql =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && $files != "$sql" ]] || die 'For S3 use distinct filenames relative to the prefix'
    aws "${aws_args[@]}" s3 cp "$s3$files" "$temp/download/$files" --only-show-errors
    aws "${aws_args[@]}" s3 cp "$s3$sql" "$temp/download/$sql" --only-show-errors
  fi
)

if [[ -n $s3 ]]; then
  download_backup
  if [[ -n $set ]]; then
    updraft=$temp/download
  else
    files=$temp/download/$files
    sql=$temp/download/$sql
  fi
fi
fingerprint=$(backup_helper stage "$temp" "$max_gib" "$prefix" "$updraft" "$set" "$files" "$sql")
fingerprint=$(printf '%s\0' "$fingerprint" "$uid" "$gid" "$prefix" | sha256sum)
fingerprint=${fingerprint%% *}
if [[ $action == dry-run ]]; then
  log "Backup staged successfully. Fingerprint: $fingerprint"
  exit 0
fi
if [[ $status == applied && $(cat -- "$snapshot/fingerprint") == "$fingerprint" ]]; then
  log 'This backup is already applied.'
  exit 0
fi
[[ $(resolve_target stopped) == "$target" ]] || die 'WordPress mount changed'
snapshot=$(mktemp -d -- "$slot/snap.XXXXXXXX")
mkdir -- "$snapshot/content"
rsync -aHAX --numeric-ids -- "$target/" "$snapshot/content/"
dump_args=(--single-transaction --quick --hex-blob --no-tablespaces --triggers --routines --events --add-drop-database --databases)
if [[ $dump == */mysqldump ]]; then dump_args+=(--set-gtid-purged=OFF); fi
docker exec "$db_id" "$dump" "--defaults-file=$db_cnf" --protocol=socket "${dump_args[@]}" "$database" > "$snapshot/db.sql"
[[ -s $snapshot/db.sql ]] || die 'Empty snapshot SQL'
printf '%s\n' "$fingerprint" > "$snapshot/fingerprint"
backup_helper seal "$snapshot"
mark pending
printf '%s\n' "${snapshot##*/}" > "$slot/.latest.tmp"
mv -f -- "$slot/.latest.tmp" "$slot/latest"
sync -f "$slot"
armed=true

schema=$(query "$database" -e 'SELECT DEFAULT_CHARACTER_SET_NAME, DEFAULT_COLLATION_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = DATABASE()')
IFS=$'\t' read -r charset collation <<< "$schema"
[[ $charset =~ ^[a-zA-Z0-9_]+$ && $collation =~ ^[a-zA-Z0-9_]+$ ]] || die 'Cannot determine database encoding'
query -e "DROP DATABASE \`$database\`; CREATE DATABASE \`$database\` CHARACTER SET $charset COLLATE $collation;"
query "$database" < "$temp/import.sql"
count=$(query "$database" -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_type = 'BASE TABLE' AND table_name IN ('$prefix""options','$prefix""posts','$prefix""users')")
[[ $count == 3 ]] || die 'Missing WordPress core tables. Check the source table prefix.'
rsync -rltpgo --checksum --chown="$uid:$gid" --chmod=D755,F644 -- "$temp/content/" "$target/"
sync -f "$target"
mark applied
armed=false
log "Apply completed. Snapshot: $snapshot"
)

ask() {
  local label=$1 default=${2-}
  if [[ -n $default ]]; then label="$label [$default]"; fi
  IFS= read -r -p "$label: " answer || die 'Ввод прерван'
  answer=${answer:-$default}
}

wizard_cleanup_cnf() {
  if [[ -n $temp_cnf ]]; then
    docker exec "$db_id" rm -f -- "$temp_cnf" ||
      log "Удалите временный файл БД в контейнере: $temp_cnf"
    temp_cnf=
  fi
}

wizard_choose_container() (
  local label=$1 excluded=$2 row key sequence name terminal_settings
  local selected=0 first=0 rendered=0 height width visible index
  local -a rows=()
  shift 2
  for row in "$@"; do
    name=${row%%$'\t'*}
    if [[ $name != "$excluded" ]]; then rows+=("$row"); fi
  done

  terminal_settings=$(stty -g <&3) || return 1
  trap 'stty "$terminal_settings" <&3' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # Keep echo and line buffering off between key reads and redraws.
  stty -echo -icanon min 1 time 0 <&3 || return 1

  while :; do
    if ! read -r height width < <(stty size <&3); then height=24 width=80; fi
    visible=$((height > 3 ? height - 3 : 1))
    if ((visible > ${#rows[@]})); then visible=${#rows[@]}; fi
    width=$((width > 3 ? width - 3 : 77))
    if ((selected < first)); then first=$selected; fi
    if ((selected >= first + visible)); then first=$((selected - visible + 1)); fi
    if ((first + visible > ${#rows[@]})); then first=$((${#rows[@]} - visible)); fi

    if ((rendered)); then printf '\033[%dA\r\033[J' "$rendered" >&3; fi
    printf '%s (↑/↓, Enter)\n' "$label" >&3
    for ((index=first; index<first+visible; index++)); do
      row=${rows[index]//$'\t'/ }
      if ((index == selected)); then
        printf '> %.*s\n' "$width" "$row" >&3
      else
        printf '  %.*s\n' "$width" "$row" >&3
      fi
    done
    rendered=$((visible + 1))

    IFS= read -rN1 -u 3 key || die 'Ввод прерван'
    case "$key" in
      $'\n'|$'\r')
        name=${rows[selected]%%$'\t'*}
        printf '\033[%dA\r\033[J%s: %s\n' "$rendered" "$label" "$name" >&3
        printf '%s\n' "$name"
        return 0 ;;
      $'\004') die 'Ввод прерван' ;;
      $'\e')
        if ! IFS= read -rN2 -t 0.2 -u 3 sequence; then continue; fi
        case "$sequence" in
          '[A'|'OA') if ((selected > 0)); then selected=$((selected - 1)); fi ;;
          '[B'|'OB') if ((selected + 1 < ${#rows[@]})); then selected=$((selected + 1)); fi ;;
        esac ;;
    esac
  done
) 3<>/dev/tty

wizard_target() {
  local db_password containers
  local -a container_rows
  command -v docker >/dev/null || { log 'Требуется Docker Engine'; return 1; }
  wizard_cleanup_cnf
  containers=$(docker ps -a --format '{{.Names}}\t{{.Image}}\t{{.Status}}') || return
  mapfile -t container_rows <<< "$containers"
  (("${#container_rows[@]}" >= 2)) || { log 'Нужны два контейнера: WordPress и MariaDB/MySQL'; return 1; }
  wp_name=$(wizard_choose_container 'Контейнер WordPress' '' "${container_rows[@]}") || die 'Выбор контейнера прерван'
  db_name=$(wizard_choose_container 'Контейнер MariaDB/MySQL' "$wp_name" "${container_rows[@]}") || die 'Выбор контейнера прерван'
  [[ $wp_name =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ && $db_name =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] ||
    { log 'Укажите имена контейнеров из списка'; return 1; }
  wp_id=$(docker inspect --type container --format '{{.Id}}' "$wp_name") || return
  db_id=$(docker inspect --type container --format '{{.Id}}' "$db_name") || return
  [[ $wp_id != "$db_id" ]] || { log 'Укажите два разных контейнера'; return 1; }
  docker inspect --format '{{range .Mounts}}{{println .Destination .Type .Name}}{{end}}' "$wp_id" || return
  ask 'Точка монтирования в WordPress' /var/www/html
  wp_mount=$answer
  ask 'Путь к wp-content в контейнере' /var/www/html/wp-content
  wp_content=$answer
  ask 'Имя базы данных' wordpress
  database_name=$answer
  ask 'Префикс таблиц' wp_
  table_prefix=$answer
  ask 'Каталог состояния на VPS' /var/lib/wp-migrate-kit
  state_path=$answer
  ask 'UID владельца файлов' 33
  owner_uid=$answer
  ask 'GID владельца файлов' 33
  owner_gid=$answer
  ask 'Авторизация БД (1 — ввести логин и пароль, 2 — использовать файл .cnf)' 1
  case "$answer" in
    1)
      ask 'Имя пользователя БД'
      db_user=$answer
      [[ $db_user =~ ^[a-zA-Z0-9_.@-]+$ ]] || { log 'Недопустимое имя пользователя БД'; return 1; }
      [[ $(docker inspect --format '{{.State.Running}}' "$db_id") == true ]] || { log 'Контейнер БД должен работать'; return 1; }
      set +x
      IFS= read -rs -p 'Пароль пользователя БД: ' db_password || die 'Ввод прерван'
      printf '\n' >&2
      [[ $db_password != *$'\r'* ]] || { log 'Недопустимый символ в пароле'; return 1; }
      db_password=${db_password//\\/\\\\}
      db_password=${db_password//\"/\\\"}
      temp_cnf=$(printf '[client]\nuser="%s"\npassword="%s"\n' "$db_user" "$db_password" |
        docker exec -i "$db_id" sh -ec '
          umask 077
          file=$(mktemp /tmp/wp-migrate.XXXXXXXX)
          if cat >"$file"; then printf "%s\n" "$file"; else rm -f -- "$file"; exit 1; fi') || { unset db_password; return 1; }
      unset db_password
      option_file=$temp_cnf ;;
    2)
      ask 'Путь к .cnf внутри контейнера БД' /run/secrets/wp-migrate.cnf
      option_file=$answer ;;
    *) log 'Выберите 1 или 2'; return 1 ;;
  esac
  target_args=(--wp "$wp_id" --db "$db_id" --database "$database_name" --db-cnf "$option_file"
    --prefix "$table_prefix" --mount "$wp_mount" --content "$wp_content" --state "$state_path"
    --uid "$owner_uid" --gid "$owner_gid")
}

wizard_source() {
  ask 'Откуда загрузить резервную копию (1 — Cloudflare R2/S3, 2 — файлы на VPS)' 1
  location=$answer
  source_args=()
  case "$location" in
    1)
      ask 'Путь S3, включая префикс и завершающий / (s3://бакет/папка/)'
      source_args+=(--s3 "$answer" --s3-prompt)
      ask 'HTTPS endpoint для R2 или другого S3 (Enter для AWS S3)'
      if [[ -n $answer ]]; then source_args+=(--endpoint "$answer"); fi
      ask 'Регион S3 (Enter для региона по умолчанию)'
      if [[ -n $answer ]]; then source_args+=(--region "$answer"); fi ;;
    2) ;;
    *) log 'Выберите 1 или 2'; return 1 ;;
  esac
  ask 'Формат резервной копии (1 — UpdraftPlus, 2 — архив и SQL)' 1
  case "$answer" in
    1)
      if [[ $location == 2 ]]; then
        ask 'Каталог архивов UpdraftPlus на VPS'
        source_args+=(--updraft "$answer")
      fi
      ask 'Имя набора UpdraftPlus без суффикса -db.gz или -uploads.zip'
      source_args+=(--set "$answer") ;;
    2)
      ask 'Архив файлов (имя объекта S3 или путь на VPS)'
      source_args+=(--files "$answer")
      ask 'SQL-дамп (имя объекта S3 или путь на VPS)'
      source_args+=(--sql "$answer") ;;
    *) log 'Выберите 1 или 2'; return 1 ;;
  esac
  ask 'Лимит распаковки в ГиБ' 50
  source_args+=(--max-gib "$answer")
}

wizard_run_cli() {
  # A conditional call would disable errexit inside run_cli, including during writes.
  local status
  set +e
  run_cli "$@"
  status=$?
  set -e
  case "$status" in
    130|143) exit "$status" ;;
  esac
  stage_status=$status
}

wizard_write() {
  local running
  stage_status=1
  running=$(docker inspect --format '{{.State.Running}}' "$wp_id") || return 0
  if [[ $running == true ]]; then docker stop "$wp_id" >/dev/null || return 0; fi
  if [[ $operation == 1 ]]; then
    if [[ $location == 1 ]]; then log 'Для восстановления введите ключи S3 ещё раз'; fi
    wizard_run_cli apply "${target_args[@]}" "${source_args[@]}" --yes
  else
    wizard_run_cli rollback "${target_args[@]}" --yes
  fi
}

wizard_recover() {
  local retry_stage=$1 retry_label=$2
  log 'Этап завершился с ошибкой.'
  while :; do
    ask "Действие (1 — $retry_label, 2 — начать сначала, 0 — выход)" 1
    case "$answer" in
      1) stage=$retry_stage; return ;;
      2) wizard_cleanup_cnf; stage=operation; return ;;
      0) exit 1 ;;
      *) log 'Выберите 1, 2 или 0' ;;
    esac
  done
}

wizard() (
  [[ $(uname -s) == Linux && $EUID == 0 ]] || die 'Запустите мастер от root на Linux VPS'
  if ! { exec </dev/tty; } 2>/dev/null; then die 'Для мастера нужен интерактивный терминал'; fi
  unset DOCKER_CONTEXT
  export DOCKER_HOST=unix:///var/run/docker.sock

  local stage=operation stage_status temp_cnf= db_id=
  trap wizard_cleanup_cnf EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  while :; do
    case "$stage" in
      operation)
        ask 'Действие (1 — миграция, 2 — откат, 0 — выход)' 1
        operation=$answer
        case "$operation" in
          1|2) stage=target ;;
          0) exit 0 ;;
          *) log 'Выберите 1, 2 или 0' ;;
        esac ;;
      target)
        if wizard_target; then
          if [[ $operation == 1 ]]; then stage=source; else stage=confirm; fi
        else
          wizard_recover target 'ввести параметры цели заново'
        fi ;;
      source)
        if wizard_source; then
          stage=preflight
        else
          wizard_recover source 'ввести параметры резервной копии заново'
        fi ;;
      preflight)
        log 'Проверка цели и резервной копии'
        wizard_run_cli preflight "${target_args[@]}" "${source_args[@]}"
        if ((stage_status == 0)); then stage=dry_run; else
          wizard_recover target 'ввести параметры миграции заново'
        fi ;;
      dry_run)
        wizard_run_cli dry-run "${target_args[@]}" "${source_args[@]}"
        if ((stage_status == 0)); then stage=confirm; else
          wizard_recover source 'ввести параметры резервной копии заново'
        fi ;;
      confirm)
        if [[ $operation == 1 ]]; then
          ask 'Восстановить данные? CLI остановит WordPress при необходимости. Введите yes для подтверждения' no
        else
          ask 'Откатить данные к последнему snapshot? CLI остановит WordPress при необходимости. Введите yes для подтверждения' no
        fi
        [[ $answer == yes ]] || { log 'Изменения отменены'; exit 0; }
        ask 'Трафик закрыт, авторазвёртывание и фоновые задачи отключены? Введите yes для подтверждения' no
        [[ $answer == yes ]] || { log 'Изменения отменены'; exit 0; }
        stage=write ;;
      write)
        wizard_write
        if ((stage_status == 0)); then stage=start; else
          wizard_recover target 'ввести параметры операции заново'
        fi ;;
      start)
        ask 'Запустить WordPress сейчас? Введите yes для запуска' no
        if [[ $answer != yes ]]; then
          log 'WordPress оставлен остановленным.'
          exit 0
        fi
        if docker start "$wp_id" >/dev/null; then
          log 'WordPress запущен. Проверьте сайт перед открытием трафика.'
          exit 0
        fi
        wizard_recover start 'повторить запуск WordPress' ;;
    esac
  done
)

if (($# == 0)); then
  wizard
else
  run_cli "$@"
fi

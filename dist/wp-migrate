}
cleanup() {
  local status=$?
  trap - EXIT
  trap '' INT TERM
  if ((status)) && $armed; then
    log "Apply failed. Restoring snapshot $snapshot"
    if restore_snapshot; then
      log 'Automatic rollback completed. WordPress remains stopped.'
    else
      log 'Automatic rollback failed. Keep WordPress stopped and retry rollback.'
    fi
  fi
  if [[ -n $temp ]]; then rm -rf -- "$temp"; fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM


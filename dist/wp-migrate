wp-migrate                         # interactive wizard
wp-migrate {preflight|dry-run|apply|rollback} --wp CONTAINER --db CONTAINER
  --database NAME --db-cnf /path/in/db/container.cnf --prefix wp_
  [--mount /var/www/html] [--content /var/www/html/wp-content]
  [--state /var/lib/wp-migrate-kit] [--uid 33 --gid 33]
  [--updraft DIR --set BACKUP_STEM | --files ARCHIVE --sql DUMP]
  [--s3 s3://BUCKET/PREFIX/ [--endpoint https://HOST] [--region REGION]
   [--profile PROFILE | --s3-prompt]]
  [--max-gib 50] [--yes]

    printf '\n' >&7
    IFS= read -rs -p 'S3 secret access key: ' AWS_SECRET_ACCESS_KEY <&7 || die 'No secret key entered'
    printf '\n' >&7
    IFS= read -rs -p 'S3 session token (Enter to skip): ' AWS_SESSION_TOKEN <&7 || die 'Input cancelled'
    printf '\n' >&7
    exec 7>&-
    [[ -n $AWS_ACCESS_KEY_ID && -n $AWS_SECRET_ACCESS_KEY ]] || die 'Both S3 keys are required'
    export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
    if [[ -n $AWS_SESSION_TOKEN ]]; then export AWS_SESSION_TOKEN; else unset AWS_SESSION_TOKEN; fi
  fi
  aws_args=()
  [[ -z $endpoint ]] || aws_args+=(--endpoint-url "$endpoint")
  [[ -z $profile ]] || aws_args+=(--profile "$profile")
  if [[ -z $region && $endpoint == https://*.r2.cloudflarestorage.com ]]; then region=auto; fi
  [[ -z $region ]] || aws_args+=(--region "$region")
  log 'Downloading backup from S3...'
